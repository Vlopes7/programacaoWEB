generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Continente {
  id String @id @default(uuid())
  nome String
  descricao String?
  paises Pais[]
}

model Pais {
  id String @id @default(uuid())
  nome String
  populacao Int 
  idiomaOficial String 
  moeda String
  continenteId String 
  continente Continente @relation(fields: [continenteId], references: [id], onDelete: Cascade)
  cidades Cidade[]
}

model Cidade{
  id String @id @default(uuid())
  nome String
  populacao Int 
  latitude Float
  longitude Float
  paisId String
  pais Pais @relation(fields: [paisId], references: [id], onDelete: Cascade)
}

model Usuario {
  id    String    @id @default(uuid())
  email String @unique
  senha String
  nome String
  sobrenome String
  dataNascimento DateTime
}